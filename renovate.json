{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>st0o0/renovate-config",
    "local>st0o0/renovate-config:github-actions"
  ],
  "packageRules": [
    {
      "description": "Group all Python dependency updates (minor+patch)",
      "matchManagers": ["pep621", "homeassistant"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "python dependencies",
      "labels": ["dependencies", "python"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group major Python dependency updates (separate PR, no automerge)",
      "matchManagers": ["pep621", "homeassistant"],
      "matchUpdateTypes": ["major"],
      "groupName": "major python dependencies",
      "labels": ["dependencies", "python"]
    }
  ]
}
